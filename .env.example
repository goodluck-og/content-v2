# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# NextAuth (sign in with Google + email/password)
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Drive + YouTube)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Used to sign/verify the OAuth state param so callbacks can't be spoofed
OAUTH_STATE_SECRET=replace-with-a-random-state-secret

# Gemini (caption generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Optional: protects /api/cron from being called by anyone but Vercel Cron
CRON_SECRET=replace-with-a-cron-secret
